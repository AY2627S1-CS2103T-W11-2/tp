@startuml
!include ../style.puml
skinparam ArrowFontStyle plain

Participant ":LogicManager" as logic LOGIC_COLOR
Participant ":AddressBookParser" as abp LOGIC_COLOR
Participant ":UpdateCommandParser" as ucp LOGIC_COLOR
Participant "command:UpdateCommand" as uc LOGIC_COLOR

[-> logic : execute
activate logic
logic -> abp ++: parseCommand(commandText)
create ucp
abp -> ucp
abp -> ucp ++: parse(arguments)
create uc
ucp -> uc ++: target, contactUpdate
uc --> ucp --
ucp --> abp --: command
abp --> logic --: command

@enduml
