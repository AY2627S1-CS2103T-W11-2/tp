@startuml
!include style.puml
title Follow-up date search - selected classes
left to right direction
skinparam defaultFontName Arial
skinparam ArrowFontStyle plain
skinparam classBackgroundColor LOGIC_COLOR
skinparam arrowColor #333333
hide empty members

package Logic as LogicPackage {
  class FindCommandParser
  class FindCommand
}

package "Model" as ModelPackage {
  class "<<interface>>\nModel" as ModelApi MODEL_COLOR
  class "<<interface>>\nPredicate<U+003C>Person>" as PersonPredicate MODEL_COLOR
  class ContactMatchesFieldsPredicate MODEL_COLOR
  class Person MODEL_COLOR
  class FollowUpDate MODEL_COLOR
}

FindCommandParser ..> FindCommand : <<create>>
FindCommandParser ..> ContactMatchesFieldsPredicate : <<create>>
FindCommandParser ..> FollowUpDate : <<create>>
FindCommand -right-> "1" PersonPredicate : predicate
FindCommand ..> ModelApi : <<use>>
ContactMatchesFieldsPredicate ..|> PersonPredicate
ContactMatchesFieldsPredicate ..> Person : <<use>>
Person --> "0..1" FollowUpDate : followUpDate
@enduml
