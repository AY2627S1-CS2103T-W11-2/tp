@startuml
!include style.puml
skinparam arrowThickness 1.1
skinparam arrowColor MODEL_COLOR
skinparam classBackgroundColor MODEL_COLOR

Package Model as ModelPackage <<Rectangle>>{
Class "<<interface>>\nReadOnlyAddressBook" as ReadOnlyAddressBook
Class "<<interface>>\nReadOnlyUserPrefs" as ReadOnlyUserPrefs
Class "<<interface>>\nModel" as Model
Class AddressBook
Class ModelManager
Class UserPrefs

Class UniquePersonList
Class Person
Class Address
Class Company
Class Email
Class FollowUpDate
Class Name
Class Phone
Class Tag
Class "<<enumeration>>\nContactMethod" as ContactMethod
Class "<<enumeration>>\nEnquiryStatus" as EnquiryStatus
Class "<<enumeration>>\nSortField" as SortField

Class I #FFFFFF
}

Class HiddenOutside #FFFFFF
HiddenOutside ..> Model

AddressBook .up.|> ReadOnlyAddressBook

ModelManager .up.|> Model
Model .right.> ReadOnlyUserPrefs
Model .left.> ReadOnlyAddressBook
ModelManager -left-> "1" AddressBook
ModelManager -right-> "1" UserPrefs
UserPrefs .up.|> ReadOnlyUserPrefs

AddressBook *--> "1" UniquePersonList
UniquePersonList --> "~* all" Person
Person *--> Name
Person *--> Phone
Person *--> Email
Person *--> Address
Person *--> Company
Person *--> ContactMethod
Person *--> EnquiryStatus
Person *--> FollowUpDate
Person *--> "*" Tag

Person -[hidden]up--> I
UniquePersonList -[hidden]right-> I

Name -[hidden]right-> Phone
Phone -[hidden]right-> Email
Email -[hidden]right-> Company
Company -[hidden]right-> Address

Address -[hidden]down-> ContactMethod

ContactMethod -[hidden]right-> EnquiryStatus
EnquiryStatus -[hidden]right-> FollowUpDate
FollowUpDate -[hidden]right-> Tag

ModelManager --> "~*" Person : filtered, sorted >
SortField .left.> Person
@enduml
