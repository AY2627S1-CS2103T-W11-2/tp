<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.*?>
<HBox fx:id="cardPane" styleClass="contact-card" xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1">
  <VBox spacing="6" HBox.hgrow="ALWAYS">
    <HBox alignment="CENTER_LEFT">
      <Label fx:id="id" styleClass="card-name" minWidth="-1" />
      <Label fx:id="name" styleClass="card-name" wrapText="true" minWidth="0" HBox.hgrow="ALWAYS" />
    </HBox>
    <Label fx:id="company" styleClass="muted" wrapText="true" />
    <Label fx:id="email" styleClass="contact-summary" wrapText="true" />
    <Label fx:id="phone" styleClass="contact-summary" />
    <Label fx:id="address" styleClass="muted" wrapText="true" />
    <FlowPane fx:id="tags" hgap="6" vgap="6" styleClass="tags" />
  </VBox>
</HBox>
