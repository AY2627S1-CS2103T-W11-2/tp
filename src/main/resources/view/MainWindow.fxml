<?xml version="1.0" encoding="UTF-8"?>
<?import java.net.URL?>
<?import javafx.scene.Scene?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<fx:root type="javafx.stage.Stage" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
         title="BoothManagerPro" minWidth="860" minHeight="640" onCloseRequest="#handleExit">
  <scene>
    <Scene>
      <stylesheets><URL value="@BoothManagerPro.css" /></stylesheets>
      <VBox styleClass="app-shell">
        <HBox styleClass="brand-bar" alignment="CENTER_LEFT" spacing="16">
          <Label text="BoothManagerPro" styleClass="brand-title" />
          <Region HBox.hgrow="ALWAYS" />
          <Label text="Exhibitor contacts / Enquiries" styleClass="brand-caption" />
        </HBox>
        <MenuBar>
          <Menu text="File"><MenuItem text="Exit" onAction="#handleExit" /></Menu>
          <Menu text="Help"><MenuItem fx:id="helpMenuItem" text="User guide" onAction="#handleHelp" /></Menu>
        </MenuBar>
        <VBox styleClass="workspace" spacing="10" VBox.vgrow="ALWAYS">
          <HBox alignment="CENTER_LEFT">
            <Label text="COMMAND" styleClass="section-label" />
            <Region HBox.hgrow="ALWAYS" />
            <Label text="Enter to run  |  Ctrl+L to focus  |  F1 for help" styleClass="muted" />
          </HBox>
          <StackPane fx:id="commandBoxPlaceholder" />
          <SplitPane orientation="VERTICAL" dividerPositions="0.5" VBox.vgrow="ALWAYS" styleClass="result-split">
            <VBox minHeight="76" spacing="10">
              <Label text="RESULT" styleClass="section-label" />
              <StackPane fx:id="resultDisplayPlaceholder" VBox.vgrow="ALWAYS" />
            </VBox>
            <SplitPane dividerPositions="0.45" minHeight="120" styleClass="contact-split">
              <VBox minWidth="290" spacing="10">
                <HBox alignment="CENTER_LEFT" spacing="8">
                  <Label text="EXHIBITOR CONTACTS" styleClass="section-label" />
                  <Region HBox.hgrow="ALWAYS" />
                  <Label fx:id="recordCount" styleClass="muted" />
                </HBox>
                <StackPane fx:id="personListPanelPlaceholder" VBox.vgrow="ALWAYS" />
              </VBox>
              <VBox minWidth="330" spacing="10">
                <Label text="CONTACT DETAILS" styleClass="section-label" />
                <StackPane fx:id="contactDetailsPlaceholder" VBox.vgrow="ALWAYS" />
              </VBox>
            </SplitPane>
          </SplitPane>
        </VBox>
        <StackPane fx:id="statusbarPlaceholder" />
      </VBox>
    </Scene>
  </scene>
</fx:root>
