<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="details-scroll"
            xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">
  <VBox styleClass="details-card" spacing="14">
    <Label fx:id="contactName" styleClass="detail-name" wrapText="true" />
    <Label fx:id="company" styleClass="muted" wrapText="true" />
    <Separator />
    <Label text="EMAIL" styleClass="field-label" />
    <Label fx:id="email" wrapText="true" styleClass="detail-value" />
    <Label text="PHONE" styleClass="field-label" />
    <Label fx:id="phone" wrapText="true" styleClass="detail-value" />
    <Label text="CONTACT METHOD" styleClass="field-label" />
    <Label fx:id="contactMethod" wrapText="true" styleClass="detail-value" />
    <Label text="ADDRESS" styleClass="field-label" />
    <Label fx:id="address" wrapText="true" styleClass="detail-value" />
    <Label text="TAGS" styleClass="field-label" />
    <FlowPane fx:id="tags" hgap="6" vgap="6" styleClass="tags" />
    <Separator />
    <Label text="ENQUIRIES &amp; FOLLOW-UPS" styleClass="field-label" />
    <Label text="Enquiry status and follow-up dates are coming soon."
           wrapText="true" styleClass="muted" />
  </VBox>
</ScrollPane>
